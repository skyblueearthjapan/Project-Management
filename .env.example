# ===== PostgreSQL =====
POSTGRES_USER=pm
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=pm
DATABASE_URL=postgresql+asyncpg://pm:changeme_in_production@db:5432/pm

# ===== Meilisearch =====
# Phase A 刈り込みで削除。Phase F まで未使用。
# Meilisearch サービス自体を docker-compose から廃止したため、本セクションは無効。
# MEILI_MASTER_KEY=changeme_meili_master_key
# MEILI_ENV=production

# ===== File server (SMB マウント) =====
FILESERVER_ROOT=/mnt/fileserver
FILESERVER_UNC_BASE=\\lineworks-sv\Data
UPLOAD_DIR=/mnt/uploads

# ===== 工番マスタ Excel =====
MASTER_EXCEL_PATH_SHIN_ICHIRAN=/mnt/fileserver/総務部/社内/日程表/新一覧.xlsm
MASTER_EXCEL_PATH_NITTEI_HYO_A=/mnt/fileserver/総務部/社内/日程表/日程表A.xlsx
MASTER_SYNC_INTERVAL_SEC=60

# ===== セキュリティ =====
CORS_ORIGINS=http://localhost:5174,http://localhost:18080
WEB_PORT=18080
LAN_ALLOW_CIDR=192.168.0.0/16

# ===== メール連携 =====
# メール機能はアプリから全廃 (REFACTOR_REMOVE_MAIL.md)。
# メール送信は別途ローカル exe が本アプリの API 経由で資料取得・保存する想定。

# ===== 開発フラグ =====
DEV_MODE=true
LOG_LEVEL=info
